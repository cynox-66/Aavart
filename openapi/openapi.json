        "enum": [
          "QUEUED",
          "RUNNING",
          "FEASIBLE",
          "OPTIMAL",
          "INFEASIBLE",
          "TIMEOUT",
          "INVALID",
          "FAILED"
        ],
        "title": "PlanningRunState",
        "type": "string"
      },
