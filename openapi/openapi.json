{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "minLength": 1,
            "title": "Comment",
            "type": "string"
          },
          "reviewer": {
            "minLength": 1,
            "title": "Reviewer",
            "type": "string"
          }
        },
        "required": [
          "reviewer",
          "comment"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "DatasetCounts": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "default": 0,
            "title": "Assets",
            "type": "integer"
          },
          "jobs": {
            "default": 0,
            "title": "Jobs",
            "type": "integer"
          },
          "resources": {
            "default": 0,
            "title": "Resources",
            "type": "integer"
          },
          "sections": {
            "default": 0,
            "title": "Sections",
            "type": "integer"
          },
          "windows": {
            "default": 0,
            "title": "Windows",
            "type": "integer"
          }
        },
        "title": "DatasetCounts",
        "type": "object"
      },
      "DatasetValidationResponse": {
        "additionalProperties": false,
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/DatasetCounts"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Errors",
            "type": "array"
          },
          "snapshot_candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Candidate Id"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "snapshot_candidate_id",
          "errors",
          "counts"
        ],
        "title": "DatasetValidationResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
